{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carine-sanadina",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-06-08",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "production": {
      "name": "carine-sanadina-production",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "preview": {
      "name": "carine-sanadina-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "preview"
      }
    }
  }
}
